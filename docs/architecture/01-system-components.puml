@startuml ansispire-system-components
title Ansispire / Saberu — System Components & Collaboration — TARGET (as-designed)
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
left to right direction

actor "Operator" as OP
actor "AI agent\n(Claude / Codex)" as AI

package "SSOT" as SSOT #eef {
  file "config/manifest.yml\n(host ports + image versions)" as MAN
  file ".env\n(make manifest-sync)" as ENV
  MAN --> ENV : render
}

package "Control Plane  (controller/, on hub, ~200MB)" as CP #eaffea {
  component "Semaphore\n(Go + SQLite, docker compose)" as SEM
  component "bootstrap.yml\n(zero-touch: project/inventory/\nenv/template/RBAC/token)" as BOOT
  component "bootstrap_preflight.yml\n(API-shape contract guard)" as PRE
  database "Key Store\nvps-fleet-key (SSH)" as KS
  collections "Inventories\nvps-fleet (static)\nproduction/targets-managed (file)" as INV
  collections "Environments\nvps-audit-env / vps-onboard-env\n(ANSIBLE_CONFIG + vps_task)" as ENVR
  collections "Templates\nVPS Onboard / VPS Audit\nsite.yml / Ping / Auto-Remediation" as TPL
  BOOT --> SEM : provisions (REST API)
  PRE ..> SEM : asserts /api shape
  SEM *-- KS
  SEM *-- INV
  SEM *-- ENVR
  SEM *-- TPL
}

package "Access Layer  (cf-worker/, Cloudflare edge)" as WK #fff0e0 {
  component "Browser Wizard\nGET /" as WIZ
  component "REST API\n/vps, /vps/:alias[/audit]" as REST
}
WK ..> SEM : Inventory / Key Store / Task API\n(interim Basic Auth)

package "Data Plane  (playbooks/, roles/)" as DP #eef6ff {
  component "playbooks/vps/*\nonboard · audit · modify · remove\ndocker_host · deploy_compose" as VPS
  component "playbooks/\nsite · deploy_hub · deploy_target" as PB
  collections "roles/\ncommon · webserver · database\ninfra_baseline · ansispire_hub\nansispire_audit · geerlingguy.docker" as ROLES
  PB --> ROLES : include
}

package "Audit + Reaction Plane  (controller/audit/, EDA)" as AP #ffeef0 {
  component "relay.py\n(cursor pull Semaphore tasks)" as RELAY
  component "sink.py\n(HTTP → append-only)" as SINK
  file "events.jsonl" as EJL
  component "reactor.py\n(tail + match + Bearer + cooldown)" as REACT
  file "extensions/eda/rules.json\n(+ events.schema.json)" as RULES
  RELAY --> SINK : POST events
  SINK --> EJL : append
  REACT ..> EJL : tail
  REACT ..> RULES : match
}

node "Managed VPS Fleet\nDebian / RHEL families" as FLEET #f4f4f4 {
  component "bootstrap channel\nroot @ 22" as BC
  component "managed channel\nmanaged_user @ non-22" as MC
}

' ── collaboration / data-flow edges ──
OP --> SEM : run templates (UI)
OP --> WIZ : browser
AI ..> BOOT : make controller-bootstrap
AI ..> SEM : REST (tests / smoke)
ENV --> SEM : ports / versions
ENV --> BC : (compose targets)

SEM --> VPS : task runner executes\n(ANSIBLE_CONFIG from bound env,\n--private-key from Key Store)
SEM --> PB
VPS --> BC : onboard (root@22 bootstrap)
VPS --> MC : audit / re-validate (managed)
BC ..> MC : SSH cutover (onboard)

SEM --> RELAY : /api/events (tasks)
REACT --> SEM : trigger remediation template\n(Task API, by name)

legend right
  ── solid = drives / data flow      ┈ dashed = reads / asserts
  Control vs Data strictly decoupled (design rule §4).
  vault-free by design: templates bind an env carrying ANSIBLE_CONFIG.
endlegend
@enduml
